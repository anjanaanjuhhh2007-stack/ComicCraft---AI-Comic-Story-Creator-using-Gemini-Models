 # 6\. Database Development

 The first database version can contain:

```
User
  │
  └── ComicProject
       │
       ├── StoryBible
       ├── Character
       ├── Page
       │    └── Panel
       │         └── Dialogue
       └── Asset
```

 A simplified Prisma model:

```
model ComicProject {
  id          String      @id @default(cuid())
  title       String
  description String?
  genre       String
  style       String
  status      String      @default("draft")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  characters Character[]
  pages      Page[]
}

model Character {
  id          String       @id @default(cuid())
  projectId   String
  name        String
  description String
  personality String?
  appearance  String?
  role        String?

  project ComicProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Page {
  id          String  @id @default(cuid())
  projectId   String
  pageNumber  Int
  title       String?

  project ComicProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  panels  Panel[]

  @@unique([projectId, pageNumber])
}

model Panel {
  id              String  @id @default(cuid())
  pageId          String
  panelNumber     Int
  sceneDescription String
  visualPrompt    String?
  caption         String?
  imageUrl        String?

  page     Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  dialogue Dialogue[]

  @@unique([pageId, panelNumber])
}

model Dialogue {
  id          String @id @default(cuid())
  panelId     String
  characterId String?
  text        String
  position    String?

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)
}
```

 Then:

```
npx prisma migrate dev --name initial
```

